# Copier vers .env pour le développement local. Ne jamais versionner un vrai secret.
APP_ENV=development
HTTP_ADDR=:8080
APP_BASE_URL=http://localhost:3000
# Rôle soumis à la RLS, utilisé par l'API.
DATABASE_URL=postgres://cf_app:cf_app@localhost:5432/kodi?sslmode=disable
# Rôle propriétaire, réservé aux migrations.
MIGRATE_DATABASE_URL=postgres://cf_owner:cf_owner@localhost:5432/kodi?sslmode=disable
COOKIE_SECURE=false
# true uniquement derrière un reverse proxy maîtrisé (Caddy).
TRUST_PROXY_HEADERS=false
AUTH_RATE_PER_MINUTE=20
S3_ENDPOINT=http://localhost:9100
S3_ACCESS_KEY=kodi
S3_SECRET_KEY=kodi-dev
S3_BUCKET=kodi
S3_REGION=us-east-1
SMTP_ADDR=localhost:1025
MAIL_FROM=noreply@kodi.local
# Exposer uniquement sur un réseau privé.
METRICS_ADDR=:9090
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
