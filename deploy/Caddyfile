# Reverse proxy de production : TLS automatique, compression, routage PWA / API.
# Avec ce proxy, l'API doit tourner avec TRUST_PROXY_HEADERS=true. Le port des métriques reste privé.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	handle /api/* {
		reverse_proxy api:8080
	}
	handle {
		reverse_proxy web:3000
	}
}
